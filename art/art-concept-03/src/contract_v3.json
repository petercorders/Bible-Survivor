{
  "schema": "bible-survivors.art-contract",
  "schemaVersion": 3,
  "note": "Hand-written expectations for the art handoff (v3). The checker compares the generated manifest and PNGs against THIS file, never against the manifest's own claims. Values come from art-production-workflow.md §4-§5 (proposals) as resolved by art-production-readiness.md (v3). Base cell 32 px is the working size; 48 px enemy versions are comparison candidates only and are not part of this contract.",
  "ppu": 32,
  "pivotSpace": "pixel-edge coordinates, origin at the bottom-left corner of one frame cell, x right, y up",
  "frameLayout": "one horizontal strip per animation; frame i occupies x = i*cell.w .. (i+1)*cell.w, full height; no padding",
  "flip": {"artFaces": "right", "faceLeft": "flipX", "applyOn": "parent", "note": "flip once on the parent transform of all player layers (or on a single sprite's renderer), never per layer; path tiles and UI pieces are never flipped"},
  "manifestTop": {
    "note": "Top-level manifest fields an importer reads (added for QA A03-01). Each must exist with this JSON type. ppu, pivotSpace, frameLayout and flip must equal the values above in this file; layerOrder must equal player.layers; every player layer asset's own layerOrder must be its index in player.layers.",
    "types": {"ppu": "int", "pivotSpace": "str", "frameLayout": "str", "layerOrder": "list", "flip": "object"}
  },
  "alphaPolicies": {
    "binary": "alpha is 0 or 255 only; RGB is 0 wherever alpha is 0",
    "blend": "alpha may take only the alpha values of the palette entries this sprite uses; RGB is 0 wherever alpha is 0"
  },
  "sortingLayers": ["Ground", "GroundDecal", "Pickups", "Actors", "WeaponFX", "FX", "UI"],
  "qualityGroups": {
    "core": "always drawn",
    "optional-fx": "may be switched off by the 'FX low' option; gameplay must stay readable without it",
    "terrain": "ground tiles and decals",
    "ui": "screen-space pieces"
  },
  "stableIds": {
