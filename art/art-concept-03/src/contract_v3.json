  "player": {
    "layers": ["cloak_back", "base", "hair_short", "beard", "hood", "cloak_front"],
    "fileLayerNames": {"cloak_back": "cloak-back", "base": "base", "hair_short": "hair-short", "beard": "beard", "hood": "hood", "cloak_front": "cloak-front"},
