    "alpha": "binary",
    "sorting": "Actors",
    "facing": "right; left = flipX applied once on the parent of all layers"
  },
  "frameChange": {
    "rule": "an animated strip (fps > 0, frames > 1) must not repeat the previous frame; a looping strip also compares its last frame with its first. Reusing a non-adjacent frame (ping-pong 1 = 3) is allowed.",
    "holdAllowedPlayerLayers": ["cloak_back", "hair_short", "beard", "hood", "cloak_front"],
    "why": "these player layers may hold still while the base layer (body) moves; the base layer itself must change every frame"
  },
