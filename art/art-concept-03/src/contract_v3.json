      "pickup": ["xp_base", "xp_bonus"],
      "currency": ["gold"],
      "player": ["player"],
      "fx": ["monster_death_common", "hit_common"],
      "terrain": ["eden_ground", "eden_path", "eden_decal"],
      "ui": ["hud", "dialog"]
