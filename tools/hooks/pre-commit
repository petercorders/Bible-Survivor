#!/bin/sh
# Editor execution remains a separate local gate; portable checks never claim PlayMode PASS.
python3 tools/check_all.py || exit $?
if [ -f UnityGame/Assets/Adam/Resources/core-provenance.json ]; then
    python3 tools/unity_check_portable.py || exit $?
fi
if [ -f art/art-concept-03/export/manifest_v3.json ]; then
    python3 tools/check_art.py || exit $?
fi
if [ -f art/art-unity-font-01/export/font_manifest_v1.json ]; then
    python3 tools/check_fonts.py || exit $?
fi
