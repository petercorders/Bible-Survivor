  "notes": {
    "file": "file is relative to this manifest",
    "existingIds": "fps/loop/borders/sorting/quality of the 11 existing IDs are the art03 index values (the outer contract omits them); cell, frame count, frame order, pivot and alpha policy are unchanged",
    "pathMask": "til_eden_path-16mask_static_32 frame index = mask = N*1 + E*2 + S*4 + W*8 (bit set when that neighbour cell is path), same as AdamArtWorld.PathMask; the path outline per frame equals art03",
    "tiles": "all tiles are fully opaque (alphaValues [255]) as in art03; every grass-facing edge is plain base grass so any grass/meadow/path tile can sit next to any other without rotation or flip",
    "shadows": "two-tone #1B1424: outer alpha 51 (20%), inner alpha 77 (30%); outer silhouette equals art03. Alpha 77 comes from tokens.json color.world.shadow.inner and is not a master-v0.3 palette entry",
    "canopy": "new optional-fx GroundDecal, alpha 51 only; shade is solid at the bottom-left pivot corner and steps away from it. Other corners need flipX/flipY about the pivot. Draw above ground tiles and below shadows/actors/pickups/telegraphs; skip in lowFX; keep out of the centre 60% of the arena"
  },
  "provenance": {
    "direction": "Claude Design canvas KX2wBLHRncNVKvwZPLuHBG and art-visual-quality-01/tokens.json (color.world)",
